# Copy this file to ".env" and fill in the values, or run:  python -m scripts.generate_env
# NEVER commit the real .env file. It is listed in .gitignore.

# Environment: "development" or "production".
# In production the app refuses to start unless COOKIE_SECURE=true and origins use https.
ENVIRONMENT=development

# Signs CSRF tokens, 2FA challenges and recovery-code hashes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Encrypts 2FA (TOTP) secrets in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./secure_login.db

# Browser origin(s) of the React app, comma separated (used for CORS and the Origin check).
FRONTEND_ORIGINS=http://localhost:5174

# Session cookie settings. Use COOKIE_SECURE=true whenever the site runs over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

SESSION_LIFETIME_MINUTES=480
SESSION_IDLE_MINUTES=30

# Brute-force protection
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
IP_MAX_ATTEMPTS_PER_MINUTE=20

TOTP_ISSUER=SecureLoginSystem
